# Auto-activates the iconocracia conda env when entering this repo.
# First time after editing: run `direnv allow` from this dir to re-authorize.
#
# Optimized: bypasses `conda shell.bash hook` (1.84s) and exports env vars
# directly (~50ms). Equivalent to `conda activate iconocracy` for this env
# because it has no etc/conda/activate.d/ scripts. If activate.d hooks
# are ever added (some CUDA/compiler packages do this), revert to the
# full `conda shell.bash hook` invocation.

ENV_PREFIX="/opt/homebrew/Caskroom/miniforge/base/envs/iconocracy"
if [ -d "$ENV_PREFIX" ]; then
  PATH_add "$ENV_PREFIX/bin"
  export CONDA_PREFIX="$ENV_PREFIX"
  export CONDA_DEFAULT_ENV="iconocracy"
  export CONDA_SHLVL="1"
fi

# Repo-local PATH (uncomment if you add a bin/ folder with scripts)
# PATH_add bin

# Helpful exports for the corpus pipeline
export ICONOCRACY_REPO="$PWD"
